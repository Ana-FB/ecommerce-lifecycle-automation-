        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    to: [{ email: $json.email }],\n    templateId: 4,\n    params: {\n      FIRST_NAME: $json.first_name,\n      recommendations: $json.recommendations\n    }\n  }\n}}",
        "options": {}
