      "notes": "El cliente había recibido la campaña de reactivación (winback_sent) y ahora compró: se marca como reactivado."
    },
    {
      "parameters": {
        "resource": "contact",
        "operation": "upsert",
        "email": "={{ $('Compra Realizada (Trigger)').item.json.body.email }}",
        "upsertAttributes": {
