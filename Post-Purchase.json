    {
      "parameters": {
        "amount": 3,
        "unit": "days"
      },
      "id": "wait1",
      "name": "Esperar 3 días",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1680,
        0
      ],
      "webhookId": "0b4e99a6-3a9b-4a92-80b9-9cbd49cd2c97",
      "notes": "Tiempo antes de enviar la recomendación post-compra. Ajustable."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH datos_de_orden AS (\n  SELECT\n    orders.id AS order_id,\n    customers.email,\n    customers.first_name,\n    orders.total AS order_total\n  FROM public.orders AS orders\n  JOIN public.customers AS customers\n    ON customers.id = orders.customer_id\n  WHERE orders.id = $1::uuid\n),\n\ncategorias_compradas AS (\n  SELECT DISTINCT\n    products.category\n  FROM public.order_items AS order_items\n  JOIN datos_de_orden\n    ON datos_de_orden.order_id = order_items.order_id\n  JOIN public.products AS products\n    ON products.id = order_items.product_id\n  WHERE order_items.product_id IS NOT NULL\n),\n\nproductos_recomendados AS (\n  SELECT\n    products.product_name,\n    products.price,\n    products.image_url,\n    ROW_NUMBER() OVER (\n      ORDER BY products.product_name\n    ) AS posicion\n  FROM public.products AS products\n  WHERE products.active = true\n    AND products.stock > 0\n    AND products.category IN (\n      SELECT categorias_compradas.category\n      FROM categorias_compradas\n    )\n    AND NOT EXISTS (\n      SELECT 1\n      FROM public.order_items AS order_items\n      JOIN datos_de_orden\n        ON datos_de_orden.order_id = order_items.order_id\n      WHERE order_items.product_id = products.id\n    )\n)\n\nSELECT\n  datos_de_orden.email,\n  datos_de_orden.first_name,\n  datos_de_orden.order_total,\n  COALESCE(\n    (\n      SELECT JSONB_AGG(\n        JSONB_BUILD_OBJECT(\n          'name', productos_recomendados.product_name,\n          'price', productos_recomendados.price,\n          'image_url', productos_recomendados.image_url\n        )\n        ORDER BY productos_recomendados.posicion\n      )\n      FROM productos_recomendados\n      WHERE productos_recomendados.posicion <= 3\n    ),\n    '[]'::jsonb\n  ) AS recommendations\nFROM datos_de_orden;\n",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ $('Compra Realizada (Trigger)').item.json.body.orderId }}"
        }
      },
      "id": "getOrderProducts",
      "name": "Consultar productos de la orden",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1920,
