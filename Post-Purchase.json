            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ifWinback",
      "name": "¿FUNNEL_STAGE es winback_sent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        752,
        0
      ],
      "notes": "Compara el FUNNEL_STAGE que tenia el contacto en Brevo ANTES de esta compra. Si el nodo anterior fallo (contacto nuevo, no existe), $json.attributes es undefined -- el fallback '|| {}' evita el error y cae en la rama 'No' (customer), que es lo correcto."
    },
    {
