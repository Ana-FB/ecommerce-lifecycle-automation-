            }
          ]
        },
        "options": {}
      },
      "id": "normalizeError",
      "name": "Normalizar (error)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        304,
        -96
      ],
      "notes": "Convierte el payload del Error Trigger al mismo formato que usa el resto del pipeline."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
