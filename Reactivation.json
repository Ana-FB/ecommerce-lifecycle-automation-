              "value": "success"
            },
            {
              "id": "4",
              "name": "customer_email",
              "type": "string",
              "value": "={{ $('Buscar clientes inactivos (90 días)').item.json.email }}"
            },
            {
              "id": "5",
              "name": "entity_id",
              "type": "string",
              "value": "={{ $('Buscar clientes inactivos (90 días)').item.json.id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "setReactivationSent",
      "name": "Preparar log: Reactivación enviada",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1872,
        16
      ],
      "notes": "Arma el evento 'reactivation_sent' (email + id del cliente) para el workflow central de logging."
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "R4v2eOi69VpEtte0",
          "cachedResultName": "Monitoreo - Error Handler"
        },
        "mode": "each",
        "options": {}
      },
      "id": "execReactivationSent",
      "name": "Registrar: Reactivación enviada",
      "type": "n8n-nodes-base.executeWorkflow",
