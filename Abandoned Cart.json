    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  ca.status AS cart_status,\n  cu.first_name,\n  cu.last_name,\n  cu.email,\n  COALESCE(\n    string_agg(\n      ci.product_name || ' x' || ci.quantity || ' — $' ||\n      to_char(ci.quantity * ci.unit_price, 'FM999999990.00'),\n      E'\\n'\n      ORDER BY ci.product_name\n    ),\n    'Sin productos'\n  ) AS order_details,\n  COALESCE(SUM(ci.quantity * ci.unit_price), 0) AS cart_total\nFROM public.carts ca\nJOIN public.customers cu ON cu.id = ca.customer_id\nLEFT JOIN public.cart_items ci ON ci.cart_id = ca.id\nWHERE ca.id = $1::uuid\nGROUP BY ca.id, ca.status, cu.first_name, cu.last_name, cu.email;",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [$('Carrito Abandonado (Trigger)').item.json.body.cartId] }}"
        }
      },
